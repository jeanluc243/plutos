# Demo: PostgreSQL only (local or hosted outside Supabase)
DATABASE_TARGET=demo
DEMO_DATABASE_URL=postgresql://macbookpro@localhost:5432/plutos_dev?sslmode=disable

# Production: define these values in the hosting platform, not in this file.
# Use the Supabase transaction pooler URL (port 6543) and keep sslmode=require.
# DATABASE_TARGET=production
# SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require
